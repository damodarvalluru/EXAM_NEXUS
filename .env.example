# ===========================================================================
# ExamNexus environment template — placeholders only, never real secrets.
# Copy to .env (root) and to apps/api/.env (API + Prisma CLI read that file).
# Database: TiDB Cloud Serverless (MySQL-compatible), TLS required.
# ===========================================================================

# --- Application -----------------------------------------------------------
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173

# --- Database: TiDB Cloud --------------------------------------------------
# DATABASE_URL = least-privilege application user (runtime).
# DIRECT_URL   = cluster user with CREATE DATABASE (Prisma migrations only).
DATABASE_URL=mysql://<cluster-prefix>.<app-user>:<app-password>@<host>:4000/examnexus?sslaccept=strict
DIRECT_URL=mysql://<cluster-prefix>.root:<root-password>@<host>:4000/examnexus?sslaccept=strict

TIDB_HOST=<host>
TIDB_PORT=4000
TIDB_DATABASE=examnexus
TIDB_APP_USER=<cluster-prefix>.<app-user>
TIDB_APP_PASSWORD=<app-password>
TIDB_USER=<cluster-prefix>.root
TIDB_PASSWORD=<root-password>

DB_HOST=<host>
DB_PORT=4000
DB_NAME=examnexus
DB_USER=<cluster-prefix>.<app-user>
DB_PASSWORD=<app-password>
# Names of other projects' databases on the shared cluster — never use these for ExamNexus.
PINNACLE_DB_NAME=pinnacle_academy
FRESH_FARM_DB_NAME=fresh_farm

# --- Redis / object storage / local storage --------------------------------
REDIS_URL=redis://localhost:6379
# local or s3. Production deployments should use s3.
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=examnexus
S3_ACCESS_KEY_ID=examnexus_dev
S3_SECRET_ACCESS_KEY=examnexus_dev_secret
S3_FORCE_PATH_STYLE=true
STORAGE_LOCAL_PATH=./storage

# --- Integration gateway ---------------------------------------------------
# Comma-separated HTTPS hostnames; optionally prefix a hostname with a dot to
# include subdomains. Empty allows any public HTTPS host; pin this in production.
INTEGRATION_OUTBOUND_ALLOWLIST=
# Maximum accepted age for signed webhook timestamps (seconds).
WEBHOOK_TOLERANCE_SECONDS=300
# Opt-in background delivery of due outbound webhook events (staging/production).
WEBHOOK_RETRY_ENABLED=false
WEBHOOK_RETRY_INTERVAL_MS=30000
WEBHOOK_RETRY_BATCH_SIZE=20
OAUTH_STATE_TTL_SECONDS=600

# --- Alerting and notification delivery ------------------------------------
# HTTPS webhooks must be pinned in INTEGRATION_OUTBOUND_ALLOWLIST.
ALERT_WEBHOOK_URL=
ALERT_ESCALATION_MINUTES=15
ALERT_ONCALL_ALIAS=platform-oncall
ALERT_SLA_MINUTES=60
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_SMS_WEBHOOK_URL=
NOTIFICATION_FROM_ADDRESS=noreply@examnexus.local

# --- Billing provider (opt-in, sandbox credentials only) -------------------
BILLING_PROVIDER_BASE_URL=
BILLING_PROVIDER_KEY_ID=
BILLING_PROVIDER_KEY_SECRET=
BILLING_WEBHOOK_SECRET=

# --- Security --------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_48_byte_random_value
JWT_REFRESH_SECRET=replace_with_48_byte_random_value
ENCRYPTION_MASTER_KEY=replace_with_base64_32_byte_key
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=replace_with_random_value
PINNACLE_SESSION_SECRET=replace_with_random_value

# --- Optional identity provider --------------------------------------------
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# --- Payment / notification / identity integrations (future phases) --------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
TWILIO_WHATSAPP_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_NOTIFY_EMAIL=
CONTACT_NOTIFY_WHATSAPP=
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Miscellaneous ----------------------------------------------------------
PORT=3000
CLIENT_ORIGIN=http://localhost:3000
TRUST_PROXY=false
API_INTERNAL_URL=http://localhost:4000
ADMIN_PASSWORD_HASH=
ADMIN_DEFAULT_PASSWORD_HASH=
ADMIN_DEFAULT_PIN_HASH=
