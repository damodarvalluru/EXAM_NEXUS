# Application
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
# Informational only. The web app uses VITE_API_ORIGIN in apps/web/.env.local.
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173

# Database (application role must NOT be a superuser)
DATABASE_URL=postgresql://examnexus:examnexus_dev@localhost:5432/examnexus?schema=public
DIRECT_URL=postgresql://examnexus:examnexus_dev@localhost:5432/examnexus?schema=public
POSTGRES_USER=examnexus
POSTGRES_PASSWORD=examnexus_dev
POSTGRES_DB=examnexus

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (S3 compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=examnexus
S3_ACCESS_KEY_ID=examnexus_dev
S3_SECRET_ACCESS_KEY=examnexus_dev_secret
S3_FORCE_PATH_STYLE=true

# Local verification-document storage (Phase 3; S3 adapter is future work).
# Relative paths resolve from apps/api when started via pnpm --filter; an absolute path is safer.
STORAGE_LOCAL_PATH=./storage

# Security — replace with generated values before any deployment
JWT_ACCESS_SECRET=replace_with_48_byte_random_value
JWT_REFRESH_SECRET=replace_with_48_byte_random_value
ENCRYPTION_MASTER_KEY=replace_with_base64_32_byte_key
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:5173

# Optional identity provider (Phase 2+)
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
